# Production environment template for docker-compose.prod.yml.
#
# Copy to .env.prod and fill in real values -- never commit .env.prod itself
# (it's gitignored, see .gitignore). Do NOT reuse the credentials from the
# local dev .env: generate fresh ones for production.
#
#   cp .env.prod.example .env.prod
#
# See docs/deployment.md for the full deployment walkthrough.

# --- Domains (Caddy requests Let's Encrypt certs for these automatically) ---
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com

# --- Secrets: generate real random values, never reuse dev/example ones ---
# openssl rand -hex 32
SECRET_KEY=

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=wildlife_user
POSTGRES_PASSWORD=
POSTGRES_DB=wildlife_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=
MONGO_DB=wildlife_mongo
MONGO_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/

# --- Google OAuth2 (leave blank to disable Google sign-in) ---
# Create separate production credentials at
# https://console.cloud.google.com/apis/credentials -- do not reuse the dev
# client ID/secret. Add https://api.yourdomain.com/auth/google/callback as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/google/callback

# --- Logging ---
LOG_LEVEL=INFO

# --- Optional: pin the backend image to a specific published tag instead of
# :latest (e.g. a commit SHA from .github/workflows/docker-publish.yml) ---
# BACKEND_IMAGE=ghcr.io/samyukthatr/wildlife-monitoring-system-backend:latest
