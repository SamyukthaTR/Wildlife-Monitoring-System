# Environment variables for Wildlife Population Intelligence System
# Copy this file to .env and adjust the values as needed.

# Backend Settings
PROJECT_NAME="Wildlife Population Intelligence System"
DEBUG=True
# Signs JWTs. Change this for anything other than local development.
SECRET_KEY=change-me-in-production

# PostgreSQL / PostGIS Settings
POSTGRES_USER=wildlife_user
POSTGRES_PASSWORD=wildlife_password
POSTGRES_DB=wildlife_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MongoDB Settings
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_password
MONGO_DB=wildlife_mongo
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/
